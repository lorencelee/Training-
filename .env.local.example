# Local development
APP_SECRET=choose-a-strong-password-here

# Vercel Postgres — Vercel sets these automatically when you add the Postgres integration.
# For local dev, copy them from: Vercel dashboard → Storage → your DB → .env.local tab
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
